{
  "app-id": "io.github.cdomin1.SuizaCanvas",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": ["org.freedesktop.Sdk.Extension.rust-stable"],
  "command": "suiza",
  "finish-args": ["--share=ipc", "--socket=x11", "--socket=wayland", "--device=dri", "--filesystem=home"],
  "build-options": {"append-path": "/usr/lib/sdk/rust-stable/bin", "env": {"CARGO_HOME": "/run/build/suiza/cargo-home", "CARGO_BUILD_JOBS": "2"}},
  "modules": [{
    "name": "suiza",
    "buildsystem": "simple",
    "build-commands": [
      "cargo build --offline --release --locked",
      "install -Dm755 target/release/suiza /app/bin/suiza",
      "install -Dm644 packaging/suiza.desktop /app/share/applications/io.github.cdomin1.SuizaCanvas.desktop",
      "sed -i 's/^Icon=suiza$/Icon=io.github.cdomin1.SuizaCanvas/' /app/share/applications/io.github.cdomin1.SuizaCanvas.desktop",
      "install -Dm644 packaging/suiza-ui.xml /app/share/mime/packages/io.github.cdomin1.SuizaCanvas.xml",
      "install -Dm644 packaging/io.github.cdomin1.SuizaCanvas.metainfo.xml /app/share/metainfo/io.github.cdomin1.SuizaCanvas.metainfo.xml",
      "for size in 16 24 32 48 64 128 256 512; do install -Dm644 assets/icons/$size/suiza.png /app/share/icons/hicolor/${size}x${size}/apps/io.github.cdomin1.SuizaCanvas.png; done",
      "install -Dm644 LICENSE /app/share/licenses/suiza/LICENSE",
      "for license in assets/fonts/*LICENSE*.txt; do install -Dm644 \"$license\" /app/share/licenses/suiza/$(basename \"$license\"); done"
    ],
    "sources": [{"type": "archive", "path": "../../dist/flatpak-source.tar.gz"}]
  }]
}
